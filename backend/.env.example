APP_NAME="Menet-Tech Dashboard Go"
APP_ENV=production
HTTP_ADDR=127.0.0.1:8080
SQLITE_PATH=/opt/menettech-go/backend/storage/dashboard.db
STORAGE_PATH=/opt/menettech-go/backend/storage
FRONTEND_DIST_PATH=/opt/menettech-go/frontend
SESSION_COOKIE_NAME=menettech_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
BOOTSTRAP_ADMIN_USERNAME=admin
# WAJIB DIGANTI sebelum pertama kali dijalankan!
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
JWT_SECRET=

# WhatsApp Gateway integration (diisi setelah wa gateway berjalan)
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001
WHATSAPP_GATEWAY_API_KEY=

# Optional: MikroTik (bisa diisi dari Settings UI setelah login)
MIKROTIK_HOST=
MIKROTIK_USER=
MIKROTIK_PASS=
MIKROTIK_TEST_USERNAME=test-user

# JANGAN diaktifkan di production (hanya untuk development lokal)
# MOCK_WHATSAPP=true
