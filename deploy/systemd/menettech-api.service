[Unit]
Description=Menet-Tech ISP Billing API
After=network.target

[Service]
Type=simple
User=goapp
Group=goapp
WorkingDirectory=/opt/menettech/dashboard
ExecStart=/opt/menettech/dashboard/api
Restart=always
RestartSec=5
LimitNOFILE=65536
StandardOutput=append:/var/log/menettech/api.log
StandardError=append:/var/log/menettech/api.error.log
EnvironmentFile=/opt/menettech/dashboard/.env

# Hardening
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
