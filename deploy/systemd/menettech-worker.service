[Unit]
Description=Menet-Tech ISP Billing Worker
After=network.target menettech-api.service

[Service]
Type=simple
User=goapp
Group=goapp
WorkingDirectory=/opt/menettech/dashboard
ExecStart=/opt/menettech/dashboard/worker
Restart=always
RestartSec=5
LimitNOFILE=65536
StandardOutput=append:/var/log/menettech/worker.log
StandardError=append:/var/log/menettech/worker.error.log
EnvironmentFile=/opt/menettech/dashboard/.env

# Hardening
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
