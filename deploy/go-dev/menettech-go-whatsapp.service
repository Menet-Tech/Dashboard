[Unit]
Description=Menet-Tech Go WhatsApp Gateway
After=network.target menettech-go-api.service

[Service]
Type=simple
User=menettech
Group=menettech
WorkingDirectory=/opt/menettech-go/whatsapp
EnvironmentFile=/opt/menettech-go/backend/.env
EnvironmentFile=-/opt/menettech-go/whatsapp/.env
ExecStart=/usr/bin/node --max-old-space-size=160 src/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/menettech-go/whatsapp
MemoryHigh=200M
MemoryMax=250M

[Install]
WantedBy=multi-user.target
