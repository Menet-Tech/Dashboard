[Unit]
Description=Menet-Tech Go WhatsApp Gateway
After=network.target menettech-go-api.service

[Service]
Type=simple
User=menettech
Group=menettech
WorkingDirectory=/opt/menettech-go/whatsapp
EnvironmentFile=/opt/menettech-go/backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/menettech-go/whatsapp

[Install]
WantedBy=multi-user.target
