# Discord Bot Integration - Environment Configuration
# Binary: /opt/menettech-go/integration/discord-bot
#
# Discord bot membaca token dari sini ATAU dari Settings UI (database).
# Jika sudah dikonfigurasi via Settings UI, file ini TIDAK wajib diisi.
# Namun disarankan mengisi di sini untuk instalasi baru (fresh install).

# ── WAJIB DIISI (salah satu dari dua opsi) ──────────────────────────────────
# Opsi 1: Isi langsung di sini
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Opsi 2: Biarkan kosong dan isi dari Settings UI setelah login pertama

# ── Koneksi ke API Backend ────────────────────────────────────────────────────
# URL backend API (harus sama dengan HTTP_ADDR di backend/.env)
API_BASE_URL=http://127.0.0.1:8080

# ── Database (harus sama dengan SQLITE_PATH di backend/.env) ─────────────────
SQLITE_PATH=/opt/menettech-go/backend/storage/dashboard.db
