[Unit]
Description=Menet-Tech ISP Dashboard Worker
After=network.target menettech-api.service

[Service]
Type=simple
User=menettech
Group=menettech
WorkingDirectory=/opt/menettech-go/backend
EnvironmentFile=/opt/menettech-go/backend/.env
Environment=GOGC=20
Environment=GOMEMLIMIT=80MiB
ExecStart=/opt/menettech-go/backend/worker worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/menettech-go
# Soft memory warning at 90MB; hard ceiling 110MB (cgroup OOM killer)
MemoryHigh=90M
MemoryMax=110M

[Install]
WantedBy=multi-user.target
