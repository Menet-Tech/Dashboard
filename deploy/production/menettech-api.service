[Unit]
Description=Menet-Tech ISP Dashboard API
After=network.target

[Service]
Type=simple
User=menettech
Group=menettech
WorkingDirectory=/opt/menettech-go/backend
EnvironmentFile=/opt/menettech-go/backend/.env
ExecStart=/opt/menettech-go/backend/api api
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/menettech-go

[Install]
WantedBy=multi-user.target
