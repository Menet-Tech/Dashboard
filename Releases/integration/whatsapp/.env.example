# WhatsApp Gateway - Environment Configuration
# Runtime: Node.js (pm2 atau systemd)
# Working dir: /opt/menettech-go/integration/whatsapp

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# URL publik server ini (digunakan untuk link media di pesan WA)
PUBLIC_URL=http://your-server-ip

# ── Keamanan ──────────────────────────────────────────────────────────────────
# API Key untuk internal communication antara backend dan WA gateway
# Harus sama dengan WHATSAPP_GATEWAY_API_KEY di backend/.env
API_KEY=ganti-dengan-api-key-rahasia

# ── Koneksi ke Dashboard API (WAJIB DIISI) ────────────────────────────────────
DASHBOARD_API_URL=http://127.0.0.1:8080
DASHBOARD_INTERNAL_API_KEY=ganti-dengan-internal-key-rahasia

# ── Nomor Admin WhatsApp (format: 628123456789, tanpa +) ─────────────────────
# Pisahkan dengan koma jika lebih dari satu
ADMIN_WA_NUMBERS=628123456789

# ── Notifikasi Discord (Opsional) ─────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_ADMIN_ROLE_ID=

# ── Puppeteer / Chromium ──────────────────────────────────────────────────────
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--max-old-space-size=512
# Gunakan path di bawah jika ingin menggunakan Chromium sistem (misal: /usr/bin/chromium-browser atau /usr/bin/chromium)
# Jika dikosongkan, Puppeteer akan menggunakan browser bawaan yang diunduh secara otomatis.
PUPPETEER_EXECUTABLE_PATH=

# ── Database SQLite WhatsApp Gateway ─────────────────────────────────────────
# Lokasi file database sesi & chatbot gateway
WA_DB_PATH=/opt/menettech-go/integration/whatsapp/wa_gateway.db

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── AI Chatbot (Opsional) ─────────────────────────────────────────────────────
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-3.5-turbo

# ── JANGAN aktifkan di production! ───────────────────────────────────────────
# MOCK_WHATSAPP=true
